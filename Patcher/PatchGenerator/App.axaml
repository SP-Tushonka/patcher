<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PatchGenerator"
             x:Class="PatchGenerator.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- The installer and the patcher load the same theme, so all three match -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SPT.Theme/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- After the resources, so the style sheets' StaticResource lookups find the colours -->
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SPT.Theme/Styles.axaml" />
        <StyleInclude Source="/Assets/Styles.axaml" />
    </Application.Styles>
</Application>
