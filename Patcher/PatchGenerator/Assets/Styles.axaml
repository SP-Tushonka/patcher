<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Only what the generator adds, the rest comes from SPT.Theme -->
    <Style Selector="Border.drop">
        <Setter Property="Background" Value="{StaticResource Gray900Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gray700Brush}" />
    </Style>
    <Style Selector="Border.drop.selected">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="Button.window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Gray400Brush}" />
    </Style>
    <Style Selector="Button.window:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>
</Styles>
