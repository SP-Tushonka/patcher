<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="120"
             x:Class="PatchGenerator.CustomControls.FolderSelector"
             x:Name="Root"
             DragDrop.AllowDrop="True"
             Background="Transparent">

    <Border Classes="drop" Classes.selected="{Binding #Root.FolderSelected}"
            BorderThickness="1" CornerRadius="12" Padding="16 12">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Classes="label" Text="{Binding #Root.Label}" />
            <TextBlock Grid.Row="1" Classes="mono muted" Text="{Binding #Root.FolderPath}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0 6" />
            <Button Grid.Row="2" Classes="link" Content="Browse" HorizontalAlignment="Left" Click="Browse" />
        </Grid>
    </Border>
</UserControl>
