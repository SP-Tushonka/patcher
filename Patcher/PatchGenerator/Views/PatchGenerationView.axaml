<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="using:PatchGenerator.Models"
             xmlns:att="using:PatchGenerator.AttachedProperties"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="460"
             xmlns:vm="using:PatchGenerator.ViewModels"
             x:Class="PatchGenerator.Views.PatchGenerationView"
             x:DataType="vm:PatchGenerationViewModel">

    <Border Classes="content">
        <Border Classes="panel">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                    <TextBlock Classes="label" Text="{Binding ProgressMessage}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="mono muted" VerticalAlignment="Center"
                               Text="{Binding PatchPercent, StringFormat={}{0}%}" />
                </Grid>
                <ProgressBar Grid.Row="1" Value="{Binding PatchPercent}" IsIndeterminate="{Binding IndeterminateProgress}" />
                <TextBlock Grid.Row="2" Classes="mono muted" Margin="0 8 0 0" Text="{Binding ElapsedTimeDetails}" />

                <ItemsControl Grid.Row="3" Margin="0 14 0 8" ItemsSource="{Binding PatchItemLegendCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="18" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:PatchItem}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Fill="{Binding Color}" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Gray300Brush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="4" Background="{StaticResource Gray900Brush}" CornerRadius="8" Padding="12 8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollChanged="scrollChanged"
                                  att:RandomBoolAttProp.RandomBool="{Binding AutoScroll}">
                        <ItemsControl ItemsSource="{Binding PatchItemCollection}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type model:PatchItem}">
                                    <TextBlock Classes="mono" Text="{Binding Name}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{Binding Color}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <CheckBox Grid.Row="5" Content="Follow new lines" HorizontalAlignment="Right" Margin="0 10 0 0"
                          IsChecked="{Binding AutoScroll}" />
            </Grid>
        </Border>
    </Border>
</UserControl>
