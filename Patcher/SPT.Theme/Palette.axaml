<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared by the installer and the patcher, so both look the same -->
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://SPT.Theme/Fonts#Figtree</FontFamily>

    <Color x:Key="Gray950">#030712</Color>
    <Color x:Key="Gray900">#101828</Color>
    <Color x:Key="Gray800">#1E2939</Color>
    <Color x:Key="Gray700">#364153</Color>
    <Color x:Key="Gray600">#4A5565</Color>
    <Color x:Key="Gray500">#6A7282</Color>
    <Color x:Key="Gray400">#99A1AF</Color>
    <Color x:Key="Gray300">#D1D5DC</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Cyan700">#007595</Color>
    <Color x:Key="Cyan600">#0092B8</Color>
    <Color x:Key="Cyan500">#00B8DB</Color>
    <Color x:Key="Slate700">#314158</Color>
    <Color x:Key="Slate600">#45556C</Color>
    <Color x:Key="Slate300">#CAD5E2</Color>

    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}" />
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Slate700Brush" Color="{StaticResource Slate700}" />
    <SolidColorBrush x:Key="Slate600Brush" Color="{StaticResource Slate600}" />
    <SolidColorBrush x:Key="Slate300Brush" Color="{StaticResource Slate300}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Cyan500}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#05DF72" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FDC700" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6467" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#80364153" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Cyan700}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource Cyan600}" />
    <SolidColorBrush x:Key="NoticeBrush" Color="#E17100" />
    <SolidColorBrush x:Key="DangerCardBrush" Color="#C10007" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#008236" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#DCFCE7" />

    <LinearGradientBrush x:Key="NavBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{StaticResource Gray900}" />
        <GradientStop Offset="0.5" Color="#000000" />
        <GradientStop Offset="1" Color="{StaticResource Gray950}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{StaticResource Gray800}" />
        <GradientStop Offset="0.5" Color="{StaticResource Gray900}" />
        <GradientStop Offset="1" Color="#000000" />
    </LinearGradientBrush>
    
    <Color x:Key="SystemAccentColor">#0092B8</Color>
    <Color x:Key="SystemAccentColorDark1">#007595</Color>
    <Color x:Key="SystemAccentColorLight1">#00B8DB</Color>

    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Gray800}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Gray700}" />
    <Thickness x:Key="ComboBoxDropdownBorderPadding">0</Thickness>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

