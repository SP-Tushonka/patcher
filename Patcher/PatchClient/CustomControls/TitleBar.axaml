<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="56"
             x:Class="PatchClient.CustomControls.TitleBar"
             x:Name="Root">
    <Border Background="{StaticResource NavBrush}" BorderBrush="{StaticResource Gray800Brush}" BorderThickness="0 0 0 1"
            Height="56">
        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="20 0" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Image Source="avares://SPT.Theme/Images/spt-small.png" Width="32" Height="17" VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <TextBlock Text="{Binding #Root.Title}" FontSize="19" FontWeight="ExtraBold" Foreground="White"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Classes="window" Command="{Binding #Root.XButtonCommand}">
                <PathIcon Data="{StaticResource Close}" Width="12" Height="12" />
            </Button>
        </Grid>
    </Border>
</UserControl>
