<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="using:PatchClient.Models"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="280"
             xmlns:vm="using:PatchClient.ViewModels"
             x:Class="PatchClient.Views.PatcherView"
             x:DataType="vm:PatcherViewModel">

    <Border Classes="content">
        <Border Classes="panel" VerticalAlignment="Top">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                    <TextBlock Classes="label" Text="{Binding ProgressMessage}" FontSize="15" />
                    <TextBlock Grid.Column="1" Classes="mono muted" VerticalAlignment="Center"
                               Text="{Binding ElapsedPatchTimeDetails}" />
                </Grid>
                <ProgressBar Value="{Binding PatchPercent}" />
                <TextBlock Classes="mono muted" Margin="0 8 0 0" TextTrimming="CharacterEllipsis"
                           Text="{Binding PatchMessage}" />

                <Border Classes="divider" Margin="0 14 0 6" />

                <ItemsControl ItemsSource="{Binding LineItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:LineItemProgress}">
                            <Border Classes="divider" Padding="0 7">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="{Binding Info}" VerticalAlignment="Center"
                                               Foreground="{StaticResource Gray300Brush}" />
                                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ProgressInfo}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0 0 12 0" />
                                    <ProgressBar Grid.Column="2" Value="{Binding Progress}" Width="160"
                                                 VerticalAlignment="Center" Classes.done="{Binding Completed}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
